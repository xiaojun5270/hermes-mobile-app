{
  "expo": {
    "name": "Hermes 智能体",
    "slug": "hermes-mobile-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hermesmobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/hermes-agent.icon",
      "bundleIdentifier": "com.dintinoconte.hermesmobile",
      "buildNumber": "3",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh_CN",
        "CFBundleLocalizations": ["zh_CN"],
        "CFBundleAllowMixedLocalizations": true,
        "NSMicrophoneUsageDescription": "Hermes 仅在你主动录制音频时使用麦克风。",
        "NSPhotoLibraryAddUsageDescription": "Hermes 仅在你主动保存图片时写入照片图库。",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "YRJ252E8T3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dintinoconte.hermesmobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D97757"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hermes 使用相机扫描配对二维码，连接你自己的网关。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hermes 将你选择的照片添加到消息中。",
          "cameraPermission": "Hermes 使用相机扫描配对二维码，或拍摄你要发送给智能体的照片。",
          "microphonePermission": "Hermes 仅在你主动录制音频时使用麦克风。"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Hermes 在向你的网关发送密码或密钥前，使用 Face ID 验证你的身份。"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1318a166-de42-4f1f-a5e4-2f4c86490c3f"
      }
    },
    "owner": "gldcio"
  }
}
